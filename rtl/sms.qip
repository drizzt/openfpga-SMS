# ==============================================================================
# SMS core file list (selects the compiled subset of the vendored upstream tree)
# ==============================================================================
# Paths are relative to this .qip via $::quartus(qip_path); the full pristine
# MiSTer SMS_MiSTer rtl/ lives under upstream/ (Copybara-managed). Only the files
# listed here are compiled; MiSTer-platform-only files present under upstream/
# (keyboard.sv, lightgun.sv, compressor.sv, savestate_ui.sv, hybrid_pwm_sd.v,
# pll/, pll.v, ...) are intentionally omitted.
# ==============================================================================

# T80 Z80 CPU
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "upstream/T80/T80s.vhd"]
