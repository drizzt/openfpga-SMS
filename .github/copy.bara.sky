# Copybara: mirror the upstream MiSTer rtl/ tree onto the vendor/upstream branch,
# as rtl/upstream/ and with no local edits applied. upstream.yml opens a pull
# request merging that branch into the default branch, where git's three-way
# merge re-applies the port's own changes to vendored files.

upstream_url = "https://github.com/MiSTer-devel/SMS_MiSTer.git"
downstream_url = "https://github.com/drizzt/openfpga-SMS.git"

# Must match gateware.json .upstream.vendored.
vendor_dir = "rtl/upstream"

core.workflow(
    name = "default",

    origin = git.origin(
        url = upstream_url,
        # Fallback only: upstream.yml always passes the release commit to sync
        # to. Still set it to the upstream's real default branch, which is
        # "main" on plenty of MiSTer cores; a wrong ref here fails the config
        # with "Cannot find reference(s)".
        ref = "master",
    ),

    # Pushed straight to the vendor branch, never to the default branch. The
    # branch holds untouched upstream and must outlive every merge: it is the
    # merge base that lets git carry the port's edits across syncs, and Copybara
    # reads its own baseline from the GitOrigin-RevId trailer there. release.yml
    # keys the merge-triggered release off the same branch name.
    destination = git.destination(
        url = downstream_url,
        fetch = "vendor/upstream",
        push = "vendor/upstream",
    ),

    # 1:1 commit per upstream commit, preserving upstream history/granularity
    mode = "ITERATIVE",

    authoring = authoring.pass_thru("Copybara <copybara@example.com>"),

    origin_files = glob(["rtl/**"]),

    # The footprint Copybara owns on the vendor branch. Files under the vendor
    # dir that are absent from upstream get deleted there, keeping the mirror
    # exact.
    destination_files = glob([vendor_dir + "/**"]),

    transformations = [
        core.move("rtl", vendor_dir),

        # Normalize CRLF -> LF before merging (upstream stores mixed/CRLF endings)
        core.transform(transformations = [
            core.replace(
                before = "\r\n",
                after = "\n",
                paths = glob([vendor_dir + "/**"]),
                multiline = True,
            ),
        ], noop_behavior = "IGNORE_NOOP"),

        metadata.add_header("[UPSTREAM] ", ignore_label_not_found = True, new_line = False),
    ],
)
